# COOP-ITSM Environment Configuration
PORT=5000
NODE_ENV=development

# Database (Postgres)
POSTGRES_USER=coop_user
POSTGRES_PASSWORD=coop_pass
POSTGRES_DB=coop_itsm_db
POSTGRES_PORT=5435

# For local development connecting to Postgres container on port 5435:
DATABASE_URL=postgresql://coop_user:coop_pass@localhost:5435/coop_itsm_db?schema=public

# JWT Authentication
JWT_SECRET=coop-itsm-jwt-super-secret-key-2026-oromia
JWT_EXPIRES_IN=7d

# Client URL (CORS)
CLIENT_URL=http://localhost:5173
